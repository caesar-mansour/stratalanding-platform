# ─────────────────────────────────────────────────────────────────────────────
# StrataLanding — environment template
#
# Copy to .env.local and fill in your own values:
#     cp .env.example .env.local
#
# This file lists VARIABLE NAMES ONLY. Never commit real values.
# Generate secrets with:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Connection string. TLS certificate verification is enforced in production.
DATABASE_URL=
# Per-instance pool size. Defaults to 3 — sized for serverless, where every
# concurrent instance builds its own pool.
DB_POOL_MAX=
# Local-only escape hatch for a non-TLS Postgres. Never set in a deployment.
DB_SSL_DISABLE=

# ── Authentication & sessions ────────────────────────────────────────────────
# HS256 signing key for session JWTs. Required — the app refuses to start without it.
AUTH_SECRET=
# Admin console access token (compared in constant time).
ADMIN_ACCESS_TOKEN=
# Base32 TOTP secret for admin 2FA. Leave unset to disable admin 2FA.
ADMIN_TOTP_SECRET=
# Optional comma-separated IP allowlist for the admin surface. Fail-closed when set.
ADMIN_IP_ALLOWLIST=
# Transitional: accept the pre-session admin cookie format during a deploy window.
ADMIN_LEGACY_COOKIE=
# Admin notification recipient.
ADMIN_EMAIL=

# Optional purpose-separated keys. Each falls back to AUTH_SECRET if unset.
PRICE_OVERRIDE_HMAC_KEY=
MFA_ENC_KEY=
DOWNLOAD_TOKEN_KEY=
OTP_PEPPER=
PROPOSAL_TOKEN_KEY=

# ── Payments (PayPal REST) ───────────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" or "live".
PAYPAL_MODE=sandbox
# Required in production — webhook handling fails closed without it.
PAYPAL_WEBHOOK_ID=
# Public client id used by the browser SDK.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# ── Email (Gmail API over OAuth2) ────────────────────────────────────────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=
# Optional secondary SMTP sender (app password).
GMAIL2_USER=
GMAIL2_APP_PASSWORD=

# ── AI assistant (OpenAI) ────────────────────────────────────────────────────
OPENAI_API_KEY=
# Defaults to gpt-4o-mini if unset.
OPENAI_MODEL=
# Per-user daily message cap for the client chat assistant.
AI_DAILY_LIMIT=

# ── Scheduled jobs ───────────────────────────────────────────────────────────
# Bearer token for /api/cron/* routes. They fail closed if this is unset.
CRON_SECRET=

# ── Web Application Firewall ─────────────────────────────────────────────────
# Persist WAF verdicts to the database. Off by default — enabling it writes on
# every bot probe, which keeps a scale-to-zero database awake.
WAF_AUDIT=
# Poll and enforce the durable IP denylist at the edge.
WAF_DENYLIST=
# Automatically block repeat offenders.
WAF_AUTOBLOCK=
# Shared secret for the internal WAF logging endpoint. Deliberately has NO
# fallback to AUTH_SECRET so the signing key never reaches request logs.
WAF_LOG_SECRET=

# ── Site / analytics ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GA_DEBUG=
NEXT_PUBLIC_STRATA_METRICS_DEBUG=
GOOGLE_SITE_VERIFICATION=
# Geo-IP enrichment for the analytics beacon.
IPINFO_TOKEN=

# ── Outreach subsystem ───────────────────────────────────────────────────────
OUTREACH_ACTIVE=
OUTREACH_USER_DAILY_HARD_CAP=

# ── Misc ─────────────────────────────────────────────────────────────────────
BUSINESS_POSTAL_ADDRESS=
# Development only: bypass the admin gate. Ignored when NODE_ENV=production.
SKIP_ADMIN_AUTH=
